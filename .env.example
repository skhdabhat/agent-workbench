# ========== 服务端（Render / 本地）==========
PORT=3001

# OpenAI（可选；公开 Demo 建议不设 Key）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 公开演示站强制 Mock，避免消耗 API
PUBLIC_DEMO=true

# 分体部署时：允许的前端来源，逗号分隔
# CORS_ORIGIN=https://your-landing.vercel.app,https://your-client.vercel.app,http://localhost:5173

# MCP 沙箱目录（默认 <repo>/workspace）
# WORKSPACE_DIR=

# ========== 前端（仅 Vercel 单独部署 client 时需要）==========
# VITE_API_BASE_URL=https://your-app.onrender.com
# VITE_PUBLIC_DEMO=true
